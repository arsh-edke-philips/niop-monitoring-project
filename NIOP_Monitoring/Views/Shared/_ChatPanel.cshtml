<button id="chat-toggle" class="chat-toggle" type="button" aria-label="Open the NIOP assistant">💬</button>

<section id="chat-panel" class="chat-panel" hidden aria-label="NIOP assistant">
    <header class="chat-header">
        <span>NIOP Assistant</span>
        <span>
            <button id="chat-new" type="button" title="Start a new conversation">New</button>
            <button id="chat-close" type="button" aria-label="Close">×</button>
        </span>
    </header>

    <div id="chat-messages" class="chat-messages" aria-live="polite"></div>

    <form id="chat-form" class="chat-form">
        @Html.AntiForgeryToken()
        <textarea id="chat-input" rows="2" maxlength="2000"
                  placeholder="Ask about an order, device, report..."></textarea>
        <button id="chat-send" type="submit">Send</button>
    </form>
</section>